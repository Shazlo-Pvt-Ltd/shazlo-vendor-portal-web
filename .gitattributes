# Shell scripts run inside Linux containers (the Postgres init script among them): keep LF in
# the working tree on every OS, or bash chokes on the carriage return after "set -euo pipefail".
*.sh text eol=lf

# openapi-typescript writes LF. With core.autocrlf on Windows a CRLF checkout of the generated file
# makes `npm run api:check` report stale types that are not stale.
apps/vendor-portal/src/api/schema.d.ts text eol=lf
# The other generated API types (the proposed routes, the admin module's, the shell's) have the same
# checks; the admin module's come from openapi.admin.json (ADR 0011).
apps/vendor-portal/src/api/proposed.d.ts text eol=lf
apps/vendor-admin/src/api/*.d.ts text eol=lf
apps/shazlo-one/src/api/*.d.ts text eol=lf

# The committed OpenAPI documents are written with LF by the export commands. With
# core.autocrlf on Windows a CRLF checkout makes the staleness check report a diff that is
# not one.
services/*/openapi.json text eol=lf
services/*/openapi.admin.json text eol=lf
