NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Comma-separated allowed origins. Unset allows every origin: set it on any deployed service.
CORS_ORIGIN=http://localhost:5173
# Not read by any code in backend/ today (nothing signs tokens).
JWT_SECRET=change-me-to-a-long-random-string

# Mounts the UNAUTHENTICATED /api/admin and /api/upload routes. Local development only;
# leave it unset (or false) on any deployed service.
LEGACY_ADMIN_ENABLED=true

# Cloudinary (used by routes/upload.js)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
