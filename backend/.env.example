NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Proxies in front of the app, for the client address the rate limits key on: a hop count (for
# example 1) or a comma-separated list of proxy addresses or subnets. Leave it empty when clients
# connect directly; "true" and 0.0.0.0/0 are refused. Behind Render's proxy it must be set: see
# README.md, "Rate limits".
TRUST_PROXY=
# Comma-separated allowed origins. Unset allows every origin: set it on any deployed service.
CORS_ORIGIN=http://localhost:5173
# Not read by any code in backend/ today (nothing signs tokens).
JWT_SECRET=change-me-to-a-long-random-string

# true mounts the UNAUTHENTICATED /api/admin and /api/upload routes. Set it to true in a
# local .env only; leave it false (or unset) on any deployed service.
LEGACY_ADMIN_ENABLED=false

# Cloudinary (used by routes/upload.js)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
