NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Proxies in front of the app, for the client IP that rate limits key on: a hop count (for example 1)
# or a comma-separated list of proxy addresses/subnets. Leave empty when clients connect directly;
# "true" and 0.0.0.0/0 are refused. Behind a proxy (Render, likely 3) it must be set: see README.md, "Rate limits".
TRUST_PROXY=
# The next two are not read by any code in backend/ today (CORS is open and nothing signs tokens).
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Cloudinary (used by routes/upload.js)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
