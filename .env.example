# Used by docker-compose.yml. Copy to .env (git-ignored).
POSTGRES_USER=shazlo
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

REDIS_PORT=6379

IDENTITY_API_PORT=8001
# Origins allowed to call identity-api with credentials (the Shazlo-One shell), comma separated.
IDENTITY_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Only for `docker compose --profile identity`: the RS256 signing key(s) as one-line JSON
# {"<kid>": "<PEM>"}. README.md (Local development) shows how to make it.
IDENTITY_JWT_KEYS=
# Needed only when IDENTITY_JWT_KEYS holds more than one key.
IDENTITY_JWT_SIGNING_KID=

VENDOR_API_PORT=8002
# Origins allowed to call vendor-api with credentials (the vendor portal), comma separated.
VENDOR_CORS_ALLOWED_ORIGINS=http://localhost:5174

# Local email catcher (Mailpit). The UI shows every email the services send.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
