# Used by docker-compose.yml. Copy to .env (git-ignored).
POSTGRES_USER=shazlo
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

REDIS_PORT=6379

IDENTITY_API_PORT=8001
# Origins allowed to call identity-api with credentials (the Shazlo-One shell), comma separated.
IDENTITY_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Only for `docker compose --profile identity`: the RS256 signing key(s) as one-line JSON
# {"<kid>": "<PEM>"}. README.md (Local development) shows how to make it.
IDENTITY_JWT_KEYS=
# Needed only when IDENTITY_JWT_KEYS holds more than one key.
IDENTITY_JWT_SIGNING_KID=

VENDOR_API_PORT=8002
# central-stub (`--profile central`), the stand-in for the central app. Published on 127.0.0.1 only.
CENTRAL_STUB_PORT=8003
# To watch an approval arrive, uncomment the next line: vendor-worker (started with the `vendor`
# profile) then delivers to central-stub (see http://localhost:8003). The steps are in
# docs/runbooks/central-publishing.md.
# CENTRAL_PUBLISHING_ENABLED=true
# Where vendor-worker sends events, and the key id and secret it signs with. The defaults are the pair
# central-stub knows (a development secret, never deployed), so these need no setting locally. To
# change the pair, set both sides: CENTRAL_SIGNING_* here and CENTRAL_STUB_SIGNING_KEYS (`key-id:secret`).
# CENTRAL_API_URL=http://central-stub:8003
# CENTRAL_SIGNING_KEY_ID=k1
# CENTRAL_SIGNING_SECRET=central-stub-dev-secret-change-me-0123456789
# CENTRAL_STUB_SIGNING_KEYS=k1:central-stub-dev-secret-change-me-0123456789
# The time of day (UTC, HH:MM) of the worker's nightly reconciliation with the central app.
# RECONCILE_AT=03:00
# Image uploads: set all three (a test Cloudinary account) to try them; empty means the asset
# endpoints answer 503 and everything else works.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_ROOT_FOLDER=shazlo-dev
# Origins allowed to call vendor-api with credentials, comma separated: the vendor portal (5174) and
# Shazlo-One's reference module (5175, `npm run dev:with-module`), which calls /v1/admin/me.
VENDOR_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175
# Where the links in vendor-api's emails point: the vendor portal.
VENDOR_PORTAL_BASE_URL=http://localhost:5174
# Only for `docker compose --profile vendor`: vendor-api's own RS256 signing key(s) as one-line
# JSON {"<kid>": "<PEM>"}. README.md (Local development) shows how to make it. Not the same key
# as IDENTITY_JWT_KEYS.
VENDOR_JWT_KEYS=
# Needed only when VENDOR_JWT_KEYS holds more than one key.
VENDOR_JWT_SIGNING_KID=

# Local email catcher (Mailpit). The UI shows every email the services send.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
