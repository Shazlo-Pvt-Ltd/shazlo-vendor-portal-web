{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shazlo.store/central-ingest/v1/product.published.schema.json",
  "title": "product.published",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "product.published"
        },
        "aggregate": {
          "type": "object",
          "properties": {
            "type": {
              "const": "product"
            }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product_id",
            "vendor_id",
            "sku",
            "title",
            "category",
            "gender",
            "variants",
            "images",
            "returnable",
            "published_at"
          ],
          "properties": {
            "product_id": {
              "type": "string",
              "format": "uuid"
            },
            "vendor_id": {
              "type": "string",
              "format": "uuid"
            },
            "sku": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 4000
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "subcategory": {
              "type": "string"
            },
            "gender": {
              "enum": [
                "women",
                "men",
                "unisex"
              ]
            },
            "fabric": {
              "type": "string",
              "maxLength": 80
            },
            "variants": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "variant_id",
                  "sku",
                  "price_paise",
                  "mrp_paise"
                ],
                "description": "mrp_paise must be greater than or equal to price_paise. No stock is carried here.",
                "properties": {
                  "variant_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "sku": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "size": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "color": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "price_paise": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Money in paise (1 INR = 100 paise), integer"
                  },
                  "mrp_paise": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Money in paise (1 INR = 100 paise), integer"
                  }
                }
              }
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "position"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://"
                  },
                  "position": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "alt": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            },
            "weight_grams": {
              "type": "integer",
              "minimum": 1
            },
            "returnable": {
              "type": "boolean"
            },
            "return_window_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "published_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "if": {
            "type": "object",
            "properties": {
              "returnable": {
                "const": true
              }
            },
            "required": [
              "returnable"
            ]
          },
          "then": {
            "required": [
              "return_window_days"
            ],
            "properties": {
              "return_window_days": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  ]
}
