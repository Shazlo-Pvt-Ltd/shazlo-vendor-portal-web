# Copy to .env (git-ignored) for local runs outside docker-compose.
ENV=dev
LOG_LEVEL=INFO

# The `vendor` database from the root docker-compose (`vendor_test` is for the tests).
DATABASE_URL=postgresql+asyncpg://shazlo:change-me@localhost:5432/vendor
REDIS_URL=redis://localhost:6379/0

# Origins allowed to call the API with credentials (the vendor portal), comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Refresh-token cookie (used by vendor login). Browsers accept Secure cookies on http://localhost,
# so this can stay true; set it to false only if your browser or curl refuses them.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# No COOKIE_DOMAIN: the refresh cookie is host-only, so it only ever goes back to this service.

# `iss` of the tokens vendor-api issues itself: this service's base URL.
JWT_ISSUER=http://localhost:8002
# vendor-api signs its own tokens with its own RS256 key, never identity-api's. The service does
# not start without one. Create it with:
#   python -m vendor_api.cli generate-key
# which writes ./.keys/<kid>.pem and prints the two lines below to set.
JWT_KEYS_DIR=.keys
JWT_SIGNING_KID=
# Or the keys as one-line JSON {"<kid>": "<PEM>"} (used by docker-compose):
# JWT_KEYS=
# Admin tokens come from identity-api (ADR 0009): its JWKS and its `iss`. Both or neither; without
# them there is no /v1/admin group. https outside dev; prod requires them. The JWKS is fetched on
# the first admin token, so vendor-api starts while identity-api is down.
IDENTITY_JWKS_URL=http://localhost:8001/.well-known/jwks.json
IDENTITY_ISSUER=http://localhost:8001

# Rate limits: "<limit>/<window seconds>" per endpoint (see README, Rate limits). Defaults are fine
# to start with.
# RATE_LIMIT_SIGNUP_IP=10/3600
# RATE_LIMIT_LOGIN_EMAIL=5/900
# Required in prod (at least 32 characters, the same on every instance, not identity-api's):
# RATE_LIMIT_HMAC_KEY=
# CIDRs of the reverse proxies whose X-Forwarded-For is believed; empty = the TCP peer is the client.
# TRUSTED_PROXIES=10.0.0.0/8

# How long an invite link and a password-reset link work, in minutes (24 hours / 1 hour).
# INVITE_TOKEN_TTL_MINUTES=1440
# RESET_TOKEN_TTL_MINUTES=60

# Sessions: refresh tokens live 7 days (a family 30), and a reused one within 10 seconds is a
# concurrent request, not theft. 0 revokes the family on any reuse.
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_FAMILY_MAX_DAYS=30
# REFRESH_REUSE_GRACE_SECONDS=10
# Access-token lifetime in seconds (1 to 3600).
# ACCESS_TOKEN_TTL_SECONDS=900

# Email (signup verification, invites, password reset). `console` sends nothing and logs the link
# (ENV=dev only); `smtp` sends through a server. Locally, `docker compose up -d` runs Mailpit,
# which catches every email: read them at http://localhost:8025.
EMAIL_BACKEND=smtp
EMAIL_FROM=Shazlo <no-reply@shazlo.store>
SMTP_HOST=localhost
SMTP_PORT=1025
# `none` for Mailpit only. Production needs `starttls` (port 587) or `ssl` (port 465).
SMTP_SECURITY=none
# A provider's credentials, set both or neither. Never commit them.
# SMTP_USER=
# SMTP_PASSWORD=
# The vendor portal's address: the links in emails point here (no trailing slash needed).
PORTAL_BASE_URL=http://localhost:5174
# How long an email-verification link works, in minutes (default 24 hours).
# EMAIL_VERIFICATION_TTL_MINUTES=1440
# Argon2id cost and the shortest password (OWASP baseline defaults).
# ARGON2_MEMORY_COST_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
# PASSWORD_MIN_LENGTH=12
# Tries per email before giving up (the pause doubles between them).
# EMAIL_SEND_ATTEMPTS=3

# Bulk product import (.xlsx / .csv): the largest file in bytes (2 MiB) and the most data rows.
# IMPORT_MAX_BYTES=2097152
# IMPORT_MAX_ROWS=1000
