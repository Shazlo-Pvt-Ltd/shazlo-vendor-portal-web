# Copy to .env (git-ignored) for local runs outside docker-compose.
ENV=dev
LOG_LEVEL=INFO

# The `vendor` database from the root docker-compose (`vendor_test` is for the tests).
DATABASE_URL=postgresql+asyncpg://shazlo:change-me@localhost:5432/vendor
REDIS_URL=redis://localhost:6379/0

# Origins allowed to call the API with credentials (the vendor portal), comma separated.
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Refresh-token cookie (used by vendor login). Browsers accept Secure cookies on http://localhost,
# so this can stay true; set it to false only if your browser or curl refuses them.
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
# Leave unset locally. In production use the shared parent domain, e.g. COOKIE_DOMAIN=shazlo.store
# COOKIE_DOMAIN=

# `iss` of the tokens vendor-api issues itself: this service's base URL.
JWT_ISSUER=http://localhost:8002
# vendor-api signs its own tokens with its own RS256 key, never identity-api's. The service does
# not start without one. Create it with:
#   python -m vendor_api.cli generate-key
# which writes ./.keys/<kid>.pem and prints the two lines below to set.
JWT_KEYS_DIR=.keys
JWT_SIGNING_KID=
# Or the keys as one-line JSON {"<kid>": "<PEM>"} (used by docker-compose):
# JWT_KEYS=
# Access-token lifetime in seconds (1 to 3600).
# ACCESS_TOKEN_TTL_SECONDS=900
