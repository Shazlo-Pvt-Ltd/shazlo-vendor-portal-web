              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "`rate_limited`: Too many requests; wait `Retry-After` seconds."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Exchange Token",
        "tags": [
          "auth"
        ]
      }
