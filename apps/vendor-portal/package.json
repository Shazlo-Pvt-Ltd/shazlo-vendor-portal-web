{
  "name": "@shazlo/vendor-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "api:generate": "openapi-typescript ../../services/vendor-api/openapi.json -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../../services/vendor-api/openapi.json -o src/api/schema.d.ts --check"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@shazlo/ui": "*",
    "@tanstack/react-query": "^5.107.1",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.2.1",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "vite": "^8.3.6"
  }
}
