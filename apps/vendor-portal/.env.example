# The vendor-api the portal talks to: an origin, no path, no credentials. Must be https outside
# development. It is read when the app is built, so it is visible to anyone who opens the app:
# never put a secret here.
VITE_VENDOR_API_URL=http://localhost:8002

# Demo mode: "on" answers the API from the in-browser mocks (src/mocks) through a service worker,
# for demos and the browser tests (npm run e2e). "off" (the default) talks to VITE_VENDOR_API_URL,
# which is still required and checked: in demo mode give it any https origin, for example
# https://demo-api.shazlo.invalid. Anything other than on or off shows the misconfigured page.
VITE_MOCK_API=off
