# Copy to .env.local (never committed). Every value is checked by src/config/env.ts when the shell is
# built or served; a production build with a bad or missing one fails.

# identity-api: "on" mocks it in the browser with demo accounts; "off" uses the real one. Unset, `npm run
# dev` mocks it and a production build does not. A deployed demo needs VITE_MOCK_API=on by name.
# VITE_MOCK_API=off

# identity-api's origin (https, no path). Required for a production build that is not a demo. Leave it
# out in development: the shell then calls its own origin and Vite forwards /v1 to
# VITE_IDENTITY_PROXY_TARGET, so the refresh cookie is first-party.
# VITE_IDENTITY_API_URL=https://identity.shazlo.store
# VITE_IDENTITY_PROXY_TARGET=http://localhost:8001

# The module registry built into the shell (ADR 0011). Required for a production build; without it,
# `npm run dev` uses registry/mock.json (mock on) or registry/development.json (mock off).
# VITE_SHELL_REGISTRY=registry/production.json
