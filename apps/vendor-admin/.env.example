# Copy to .env.local (never committed). Checked by src/config/env.ts when the module is built or served;
# a production build with a missing or bad value fails.

# Shazlo One's exact origin: the only page that may frame this module (frame-ancestors), and the only
# one its protocol client talks to. Development defaults to the shell's dev server.
# VITE_SHELL_ORIGIN=https://one.shazlo.store

# vendor-api's admin app (origin only). Development defaults to the shared mock on :5194
# (npm run serve -w @shazlo/mock-vendor-api); the real admin app runs on :8004.
# VITE_VENDOR_API_URL=https://vendor-admin-api.shazlo.store
